[#macro toJson node depth=0]
[@compress single_line=true]
	${jsonfn.from(node).down(depth).addAll().exclude("mgnl.*", "jcr.*", "@.*").print()}
[/@compress]
[/#macro]

[#macro pageLink id defaultValue='#']
[@compress]
	[#if id?has_content]
		[#assign targetPage = cmsfn.contentById(id)!]
		[#if targetPage!?has_content]
			${cmsfn.link(targetPage)}
		[#else]
			${defaultValue}
		[/#if]
	[#else]
		${defaultValue}
	[/#if]
[/@compress]
[/#macro]

[#macro linkOrLabel label url class='']
	[#if url?has_content]
		<a href="${url}"[#if class!?has_content] class="${class}"[/#if]>${label!}</a>
	[#else]
		${label!}
	[/#if]
[/#macro]

[#macro pageTitle id label]
	[@compress single_line=true]
		[#if label?has_content]
			${label}
		[#elseif id?has_content]
			[#assign targetPage = cmsfn.contentById(id)!]
			[#if targetPage!?has_content]
				${cmsfn.wrapForI18n(targetPage).title!}
			[/#if]
		[/#if]
	[/@compress]
[/#macro]

[#macro pageLinkLabel node]
	[@compress single_line=true]
		[#if node.linkType! == 'custom']
			${node.customLinkLabel!}
		[#elseif node.linkType! == 'page']
			[@pageTitle node.pageLinkId!'' node.pageLinkLabel!'' /]
		[/#if]
	[/@compress]
[/#macro]

[#macro pageLinkUrl node]
	[@compress single_line=true]
		[#if node.linkType! == 'custom']
			${node.customLink!}
		[#elseif node.linkType! == 'page']
			[@pageLink node.pageLinkId! /]
		[/#if]
	[/@compress]
[/#macro]

[#macro pageLinkFieldRender node class='']
	[@compress single_line=true]
		[#assign url][@pageLinkUrl node /][/#assign]
		[#assign label][@pageLinkLabel node /][/#assign]
		[@linkOrLabel label!'' url!'' class!'' /]
	[/@compress]
[/#macro]

[#macro damLink asset rendition='']
	[@compress single_line=true]
		[#if asset?has_content]
			[#assign transformation = damfn.getTransformation(asset, rendition)!]
			[#if transformation!?has_content]
				${transformation.link}
			[/#if]
		[/#if]
	[/@compress]
[/#macro]

[#macro productImage product index rendition='']
	[@productAsset product 'gallery' index rendition /]
[/#macro]

[#macro productAsset product collectionName index rendition='']
	[@compress single_line=true]
		[#if product?has_content]
			[#assign collection = product[collectionName]!]
			[#if collection!?has_content]
				[#assign assets = cmsfn.children(collection)!]
				[#if assets!?has_content]
					[#assign selectedAsset = assets[index]!]
					[#if selectedAsset!?has_content]
						[@damLink selectedAsset.asset!'' rendition /]
					[/#if]
				[/#if]
			[/#if]
		[/#if]
	[/@compress]
[/#macro]

[#macro damFileFormat asset]
	[@compress single_line=true]
		[#if asset?has_content]
			[#assign assetFormat = damfn.getAsset(asset).getFormat()!]
			[#if assetFormat!?has_content]
				${assetFormat}
			[/#if]
		[/#if]
	[/@compress]
[/#macro]

[#macro downloadLink node propertyName]
[@compress]
	[#if node?has_content && (node[propertyName])?has_content]
		${dppfn.config.contentApiServer}/download/link/${node.@id}@${propertyName}
	[/#if]
[/@compress]
[/#macro]

[#macro singleLineJsonString]
[@compress single_line=true]
	[#local captured][#nested][/#local]
	${captured?replace("^\\s+|\\s+$|\\n|\\r", "", "rm")?json_string}
[/@compress]
[/#macro]

[#macro stringIfBoolean variableToCheck outputString]
	[@compress single_line=true]
		[#if variableToCheck!?is_boolean && variableToCheck == true]
			${outputString}
		[/#if]
	[/@compress]
[/#macro]

[#macro requestScript script]
	[#if script?has_content]
		${dppfn.addRequestScript(dppfn.config.staticServer + script)}
	[/#if]
[/#macro]

[#macro title text htag='h2' tagClass='h2' additionalClass='mb-4']
	[#if text!?has_content]
		[#if htag!?has_content]
			[#assign h=htag]
		[#else]
			[#assign h='h2']
		[/#if]
		<${h} class="${tagClass} ${additionalClass}">${text}</${h}>
	[/#if]
[/#macro]

[#macro dictionaryItemProperty dictionaryName itemValue propertyName]
	[@compress single_line=true]
		[#if dictionaryName!?has_content && itemValue!?has_content && propertyName!?has_content]
			[#assign itemRoot = cmsfn.contentByPath("/dpp/${dictionaryName}/items", "dictionaries")!]
			[#if itemRoot!?has_content]
				[#list cmsfn.children(itemRoot) as item ]
					[#if item.value! == itemValue]
						${cmsfn.wrapForI18n(item)[propertyName]!item.value}
						[#return]
					[/#if]
				[/#list]
			[/#if]
		[/#if]
	[/@compress]
[/#macro]

[#function getHomepage c]
	[#local currentPage = cmsfn.page(c)]
	[#local pageHierarchy = cmsfn.ancestors(currentPage, 'mgnl:page') + [currentPage]]
	[#local root = pageHierarchy[0]]
	[#if (pageHierarchy?size >= 2) && (cmsfn.asJCRNode(root).name == 'dpp')]
		[#return pageHierarchy[1]/]
	[#else]
		[#return root /]
	[/#if]
[/#function]

[#function escape s]
	[#if s!?has_content]
		[#return s!?string?replace('"', '\\"')?replace('\'', '&apos;')]
	[/#if]
	[#return s]
[/#function]

[#function getCurrentProduct content productIdPropertyName='modelId']
	[#local currentPage = cmsfn.page(content)]
	[#local productNode = cmsfn.contentById(currentPage.modelId, "products")!]
	[#if !productNode!?has_content]
		[#local productNode = cmsfn.contentById(content[productIdPropertyName], "products")!]
	[/#if]
	[#if productNode!?has_content]
		[#return cmsfn.wrapForI18n(productNode)]
	[/#if]
[/#function]
