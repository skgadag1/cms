[#function isAllowedToViewContent ctx content]
    [#assign isInternal =  (cmsfn.isPublicInstance() && ctx.user.getProperty('internal') == 'true')
    || (cmsfn.isPreviewMode() && ctx.isInternal?has_content && ctx.isInternal == 'true')]
    [#assign isNonInternalAllowed =  (!(content.forInternals??) || !content.forInternals)]
    [#if isInternal || (cmsfn.isAuthorInstance() && !cmsfn.isPreviewMode())]
        [#return true]
    [/#if]
    [#assign isSuperTech =  (cmsfn.isPublicInstance() && ctx.user.getProperty('expertLevel') == 'supertech')
    || (cmsfn.isPreviewMode() && ctx.expertLevel?has_content && ctx.expertLevel=='supertech')]
    [#assign isExpertLevelAllowed =  (isSuperTech || !(content.forSupertechs??) || !content.forSupertechs)]
    [#if !content.forKeyAccounts!?has_content]
        [#if isExpertLevelAllowed && isNonInternalAllowed]
            [#return true]
        [/#if]
    [/#if]
    [#if content.forKeyAccounts!?has_content]
        [#assign userCompanyId =  cmsfn.isPublicInstance()?then(ctx.user.getProperty('companyId')!'', ctx.companyId!'')]
        [#assign filtered = content.forKeyAccounts?filter(tag -> cmsfn.nodeById(tag, 'category').name == userCompanyId)]
        [#if filtered!?has_content && isExpertLevelAllowed && isNonInternalAllowed]
            [#return true]
        [/#if]
    [/#if]
    [#return false]
[/#function]

[#function isAllowedToViewSection ctx content forKeyAccountsPropName]
    [#assign isInternal =  (cmsfn.isPublicInstance() && ctx.user.getProperty('internal') == 'true')
    || (cmsfn.isPreviewMode() && ctx.isInternal?has_content && ctx.isInternal == 'true')]
    [#if isInternal || (cmsfn.isAuthorInstance() && !cmsfn.isPreviewMode())]
        [#return true]
    [/#if]
    [#if content[forKeyAccountsPropName]?has_content]
        [#assign userCompanyId = cmsfn.isPublicInstance()?then(ctx.user.getProperty('companyId')!'', ctx.companyId!'')]
        [#if userCompanyId?has_content]
            [#list content[forKeyAccountsPropName] as tag]
                [#if tag == userCompanyId]
                    [#return true]
                [/#if]
            [/#list]
        [/#if]
    [/#if]
    [#return false]
[/#function]
