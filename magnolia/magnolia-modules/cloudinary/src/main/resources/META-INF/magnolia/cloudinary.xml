		</dependency>
		<dependency>
			<name>ui-admincentral</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>dam</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>dam-external-app</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>mtk</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>scheduler</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>dam-templating</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>dxp-core</name>
			<version>*</version>
		</dependency>
