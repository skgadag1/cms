			<scope>singleton</scope>
		</component>
		<component>
			<type>com.tbscg.doosan.magnolia.cloudinary.util.RenditionService</type>
			<implementation>com.tbscg.doosan.magnolia.cloudinary.util.RenditionService</implementation>
			<scope>singleton</scope>
		</component>
		<component>
			<type>com.tbscg.doosan.magnolia.cloudinary.templating.CloudinaryTemplatingFunctions</type>
			<implementation>com.tbscg.doosan.magnolia.cloudinary.templating.CloudinaryTemplatingFunctions</implementation>
			<scope>singleton</scope>
		</component>
		<component>
			<type>com.tbscg.doosan.magnolia.cloudinary.monitoring.CloudinaryApiMonitor</type>
			<implementation>com.tbscg.doosan.magnolia.cloudinary.monitoring.CloudinaryApiMonitor</implementation>
			<scope>singleton</scope>
		</component>
		<component>
			<type>org.apache.tika.Tika</type>
			<implementation>org.apache.tika.Tika</implementation>
			<scope>singleton</scope>
		</component>
		<component>
			<type>info.magnolia.dam.app.data.AssetSelectFieldSupport</type>
			<implementation>info.magnolia.dam.app.data.AssetSelectFieldSupport</implementation>
		</component>
		<component>
			<type>com.tbscg.doosan.magnolia.cloudinary.util.CloudinaryAssetFieldService</type>
			<implementation>com.tbscg.doosan.magnolia.cloudinary.util.CloudinaryAssetFieldService</implementation>
		</component>
		<type-mapping>
			<type>info.magnolia.ui.field.SafeHtmlValidatorDefinition</type>
			<implementation>com.tbscg.doosan.magnolia.cloudinary.field.definition.RichTextValidatorDefinition</implementation>
		</type-mapping>
