<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
  <name>regions</name>
  <displayName>${project.name}</displayName>
  <class>com.tbscg.doosan.magnolia.regions.RegionsModule</class>
  <versionHandler>com.tbscg.doosan.magnolia.regions.setup.RegionsVersionHandler</versionHandler>
  <version>2020.12.4</version>

  <components>
    <id>main</id>
    <component>
      <type>com.tbscg.doosan.magnolia.regions.converter.RegionToSitesConverter</type>
      <implementation>com.tbscg.doosan.magnolia.regions.converter.RegionToSitesConverter</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.regions.registry.SiteDefinitionRegistrar</type>
      <implementation>com.tbscg.doosan.magnolia.regions.registry.SiteDefinitionRegistrar</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.regions.service.RegionsService</type>
      <implementation>com.tbscg.doosan.magnolia.regions.service.impl.RegionsServiceImpl</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.regions.service.SiteService</type>
      <implementation>com.tbscg.doosan.magnolia.regions.service.impl.SiteServiceImpl</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.dxp.core.i18n.I18nUriBuilder</type>
      <implementation>com.tbscg.doosan.magnolia.regions.i18n.RegionsI18nUriBuilder</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.regions.service.LocaleService</type>
      <implementation>com.tbscg.doosan.magnolia.regions.service.impl.LocaleServiceImpl</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.regions.validator.UniqueHreflangLocaleDefinition</type>
      <implementation>com.tbscg.doosan.magnolia.regions.validator.UniqueHreflangLocaleDefinition</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>info.magnolia.ui.form.validator.definition.RegexpValidatorDefinition</type>
      <implementation>info.magnolia.ui.form.validator.definition.RegexpValidatorDefinition</implementation>
      <scope>singleton</scope>
    </component>
  </components>

  <components>
    <id>app-regions-app</id>
    <component>
      <type>info.magnolia.ui.datasource.ItemResolver</type>
      <implementation>info.magnolia.ui.contentapp.JcrNodeResolver</implementation>
    </component>

    <component>
      <type>info.magnolia.ui.framework.ContentClipboard</type>
      <implementation>info.magnolia.ui.contentapp.action.clipboard.JcrClipboard</implementation>
    </component>

    <component>
      <type>info.magnolia.ui.contentapp.Datasource</type>
      <implementation>info.magnolia.ui.datasource.jcr.JcrDatasource</implementation>
    </component>

    <component>
      <type>info.magnolia.ui.observation.DatasourceObservation</type>
      <implementation>info.magnolia.jcrbrowser.app.observation.JcrManualDataSourceObservation</implementation>
    </component>

    <component>
      <type>info.magnolia.ui.availability.AvailabilityChecker</type>
      <implementation>info.magnolia.ui.availability.JcrAvailabilityChecker</implementation>
    </component>

    <component>
      <type>info.magnolia.ui.datasource.PropertySetFactory</type>
      <implementation>info.magnolia.ui.contentapp.JcrPropertySetFactory</implementation>
    </component>

    <type-mapping>
      <type>info.magnolia.ui.contentapp.browser.TreePresenter</type>
      <implementation>info.magnolia.ui.contentapp.JcrTreePresenter</implementation>
    </type-mapping>
  </components>

  <dependencies>
    <dependency>
      <name>core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>multisite</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>observation</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>dxp-core</name>
      <version>*</version>
    </dependency>
  </dependencies>
</module>
