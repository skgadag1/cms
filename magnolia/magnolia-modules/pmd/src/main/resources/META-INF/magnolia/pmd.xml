<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
    <name>pmd</name>
    <displayName>PMD Magnolia Module</displayName>
    <class>com.tbscg.doosan.magnolia.pmd.PmdModule</class>
    <versionHandler>com.tbscg.doosan.magnolia.pmd.setup.PmdVersionHandler</versionHandler>
    <version>1</version>

    <components>
        <id>app-pmd</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.PmdNavigator</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.PmdNavigator</implementation>
        </component>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.data.provider.api.ApiService</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.data.provider.api.ApiService</implementation>
            <scope>singleton</scope>
        </component>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.data.provider.api.TokenService</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.data.provider.api.TokenService</implementation>
            <scope>singleton</scope>
        </component>
    </components>
    <components>
        <id>app-pmd-documentBrowser</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.documentBrowser.DocumentBrowserSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.documentBrowser.DocumentBrowserSubAppViewImpl</implementation>
        </component>
    </components>
    <components>
        <id>app-pmd-documentView</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.documentView.DocumentViewSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.documentView.DocumentViewSubAppViewImpl</implementation>
        </component>
    </components>
    <components>
        <id>app-pmd-schematicBrowser</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.schematicBrowser.SchematicBrowserSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.schematicBrowser.SchematicBrowserSubAppViewImpl</implementation>
        </component>
    </components>
    <components>
        <id>app-pmd-schematicView</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.schematicView.SchematicViewSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.schematicView.SchematicViewSubAppViewImpl</implementation>
        </component>
    </components>
    <components>
        <id>app-pmd-pmiBrowser</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.pmiBrowser.PmiBrowserSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.pmiBrowser.PmiBrowserSubAppViewImpl</implementation>
        </component>
    </components>
    <components>
        <id>app-pmd-scheduleBrowser</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.service.ScheduleBrowserSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.service.ScheduleBrowserSubAppViewImpl</implementation>
        </component>
    </components>
    <components>
        <id>app-pmd-scheduleView</id>
        <component>
            <type>com.tbscg.doosan.magnolia.pmd.app.service.ScheduleViewSubAppView</type>
            <implementation>com.tbscg.doosan.magnolia.pmd.app.service.ScheduleViewSubAppViewImpl</implementation>
        </component>
    </components>

    <dependencies>
        <dependency>
            <name>core</name>
            <version>*</version>
        </dependency>
        <dependency>
            <name>ui-admincentral</name>
            <version>*</version>
        </dependency>
        <dependency>
            <name>dxp-core</name>
            <version>*</version>
        </dependency>
    </dependencies>

</module>
