<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
  <name>translation-ext-config</name>
  <displayName>Google Translation Extension Configuration</displayName>
  <description>Module to bootstrap Google Translation configuration on every start</description>
  <versionHandler>com.tbscg.doosan.magnolia.translation.setup.TranslationExtConfigVersionHandler</versionHandler>
  <version>1.0.2</version>

  <dependencies>
    <dependency>
      <name>core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>dxp-core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>content-translation-support-ext-core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>content-translation-support-ext-google</name>
      <version>*</version>
    </dependency>
  </dependencies>
</module>


