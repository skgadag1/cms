<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
	<name>sso-doosan</name>
	<displayName>${project.name}</displayName>
	<description>${project.description}</description>
	<class>com.tbscg.doosan.magnolia.sso.SsoDoosanModule</class>
	<versionHandler>com.tbscg.doosan.magnolia.sso.setup.SSOConfigVersionHandler</versionHandler>
	<!-- this is not version of entire DXP platform, just version of SSO module, SSO module is versioned independently from the DXP platform -->
	<version>2233</version>

	<components>
		<id>main</id>
		<component>
			<type>com.tbscg.doosan.magnolia.sso.service.DynamoDBService</type>
			<implementation>com.tbscg.doosan.magnolia.sso.service.DynamoDBService</implementation>
			<scope>singleton</scope>
		</component>
		<component>
			<type>com.tbscg.doosan.magnolia.sso.service.UserDBService</type>
			<implementation>com.tbscg.doosan.magnolia.sso.service.UserDBService</implementation>
			<scope>singleton</scope>
		</component>
		<component>
			<type>com.tbscg.doosan.magnolia.sso.api.PassportApi</type>
			<implementation>com.tbscg.doosan.magnolia.sso.api.PassportApi</implementation>
			<scope>singleton</scope>
		</component>
	</components>
	<dependencies>
		<dependency>
			<name>core</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>sso-connector</name>
			<version>*</version>
		</dependency>
		<dependency>
			<name>dxp-core</name>
			<version>*</version>
		</dependency>
	</dependencies>
</module>
