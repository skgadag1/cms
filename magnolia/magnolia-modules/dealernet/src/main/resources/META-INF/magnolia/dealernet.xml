<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
    <name>dealernet</name>
    <displayName>${project.name}</displayName>
    <description>${project.description}</description>
    <class>com.tbscg.doosan.magnolia.dealernet.DealernetModule</class>
    <versionHandler>com.tbscg.doosan.magnolia.dealernet.setup.DealernetModuleVersionHandler</versionHandler>
    <version>${project.version}</version>

    <!-- For more information on module descriptor configuration options -->
    <!-- https://documentation.magnolia-cms.com/display/DOCS/XML-based+module+descriptor -->

    <components>
        <id>main</id>
        <type-mapping>
            <type>info.magnolia.ui.field.ConfiguredSwitchableFieldDefinition</type>
            <implementation>com.tbscg.doosan.magnolia.dealernet.field.clonableNamed.DealernetConfiguredSwitchableFieldDefinition</implementation>
        </type-mapping>

        <type-mapping>
            <type>info.magnolia.ui.field.TextFieldDefinition</type>
            <implementation>com.tbscg.doosan.magnolia.dealernet.field.clonableNamed.DealernetTextFieldDefinition</implementation>
       </type-mapping>

        <type-mapping>
            <type>info.magnolia.ui.field.CompositeFieldDefinition</type>
            <implementation>com.tbscg.doosan.magnolia.dealernet.field.clonableNamed.DealernetCompositeFieldDefinition</implementation>
        </type-mapping>
    </components>
    <dependencies>
        <dependency>
            <name>core</name>
            <version>*</version>
        </dependency>
        <!--  Add other dependencies here, e.g the mte (magnolia templating essentials).
        <dependency>
          <name>mte</name>
          <version>0.7/*</version>
        </dependency>
        -->
    </dependencies>
</module>
