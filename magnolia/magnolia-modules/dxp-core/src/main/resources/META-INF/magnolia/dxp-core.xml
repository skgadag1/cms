<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
  <name>dxp-core</name>
  <displayName>${project.name}</displayName>
  <class>com.tbscg.doosan.magnolia.dxp.core.DxpCoreModule</class>
  <versionHandler>com.tbscg.doosan.magnolia.dxp.core.setup.DxpCoreVersionHandler</versionHandler>
  <version>1.3.0</version>

  <components>
    <id>main</id>
    <component>
      <type>com.tbscg.doosan.magnolia.dxp.core.setup.placeholder.PlaceholderFacade</type>
      <implementation>com.tbscg.doosan.magnolia.dxp.core.setup.placeholder.PlaceholderFacade</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.tbscg.doosan.magnolia.filtering.ValidNodeTypesProvider</type>
      <implementation>com.tbscg.doosan.magnolia.filtering.DefaultValidNodeTypesProvider</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>info.magnolia.task.persistence.TasksStore</type>
      <implementation>com.tbscg.doosan.magnolia.dxp.core.task.CustomTasksStore</implementation>
    </component>
  </components>
  <components>
    <id>app-pages-app-detail</id>
    <component>
      <type>info.magnolia.ui.framework.ContentClipboard</type>
      <implementation>com.tbscg.doosan.magnolia.dxp.core.app.action.ClipboardContents</implementation>
      <scope>singleton</scope>
    </component>
  </components>

  <dependencies>
    <dependency>
      <name>core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>enterprise</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>workflow-jbpm</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>multisite</name>
      <version>*</version>
    </dependency>
  </dependencies>

</module>
