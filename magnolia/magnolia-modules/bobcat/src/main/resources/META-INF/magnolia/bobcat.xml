<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
  <name>bobcat</name>
  <displayName>Bobcat Magnolia Module</displayName>
  <class>com.tbscg.doosan.magnolia.bobcat.BobcatModule</class>
  <versionHandler>com.tbscg.doosan.magnolia.bobcat.setup.BobcatModuleVersionHandler</versionHandler>
  <version>1.1.7</version>

  <components>
    <id>main</id>
    <component>
      <type>com.tbscg.doosan.magnolia.bobcat.templating.BobcatTemplatingFunctions</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.templating.BobcatTemplatingFunctions</implementation>
      <scope>singleton</scope>
    </component>

    <component>
      <type>software.amazon.awssdk.services.dynamodb.DynamoDbClient</type>
      <provider>com.tbscg.doosan.magnolia.bobcat.external.dynamodb.DefaultAmazonDynamoDBClientProvider</provider>
      <scope>singleton</scope>
    </component>

    <component>
      <type>software.amazon.awssdk.services.ssm.SsmClient</type>
      <provider>com.tbscg.doosan.magnolia.bobcat.external.ssm.DefaultSSMClientProvider</provider>
      <scope>singleton</scope>
    </component>

    <component>
      <type>com.tbscg.doosan.magnolia.bobcat.BobcatModuleConfiguration</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.BobcatModule</implementation>
    </component>

    <component>
      <type>com.tbscg.doosan.magnolia.bobcat.rest.delivery.RequestLocaleResolver</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.rest.delivery.RequestLocaleResolver</implementation>
      <scope>singleton</scope>
    </component>

    <component>
      <type>com.tbscg.doosan.magnolia.bobcat.rest.delivery.I18nLabelResolver</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.rest.delivery.I18nLabelResolver</implementation>
      <scope>singleton</scope>
    </component>

    <type-mapping>
      <type>info.magnolia.rest.delivery.jcr.v2.JcrDeliveryEndpointDefinition</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.rest.delivery.BobcatConfiguredJcrDeliveryEndpointDefinition</implementation>
    </type-mapping>

    <type-mapping>
      <type>info.magnolia.ui.contentapp.JcrDataProvider</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.ui.contentapp.datasource.jcr.JcrPrimaryTypeProvider</implementation>
    </type-mapping>

    <type-mapping>
      <type>info.magnolia.ui.contentapp.HierarchicalJcrDataProvider</type>
      <implementation>com.tbscg.doosan.magnolia.bobcat.ui.contentapp.FilterableHierarchicalDataProvider</implementation>
    </type-mapping>

  </components>

  <dependencies>
    <dependency>
      <name>templating</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>dxp-core</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>regions</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>spa-rendering</name>
      <version>*</version>
    </dependency>
    <dependency>
      <name>rest-content-delivery</name>
      <version>*</version>
    </dependency>
  </dependencies>
</module>
