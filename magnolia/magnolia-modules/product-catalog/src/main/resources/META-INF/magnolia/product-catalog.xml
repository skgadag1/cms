<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
    <name>product-catalog</name>
    <displayName>Product Catalog</displayName>
    <description>Product Catalog</description>
    <class>com.tbscg.doosan.magnolia.product.catalog.ProductCatalogModule</class>
    <versionHandler>com.tbscg.doosan.magnolia.product.catalog.setup.ProductCatalogVersionHandler</versionHandler>
    <version>1.0.1</version>

    <components>
        <id>app-product-catalog</id>

        <component>
            <type>info.magnolia.ui.framework.ContentClipboard</type>
            <implementation>info.magnolia.ui.contentapp.action.clipboard.JcrClipboard</implementation>
        </component>

        <component>
            <type>com.tbscg.doosan.magnolia.product.catalog.extimport.gpim.GpimClientFactory</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.extimport.ProductCatalogGpimFactory</implementation>
            <scope>singleton</scope>
        </component>

        <component>
            <type>com.tbscg.doosan.magnolia.product.catalog.extimport.pimpp.PimppClientFactory</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.extimport.ProductCatalogClientFactory</implementation>
            <scope>singleton</scope>
        </component>

        <component>
            <type>com.tbscg.doosan.magnolia.product.catalog.extimport.PimService</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.extimport.DefaultPimService</implementation>
            <scope>singleton</scope>
        </component>

        <component>
            <type>com.tbscg.doosan.magnolia.product.catalog.extimport.buildandquote.BuildAndQuoteClient</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.extimport.buildandquote.SimpleBuildAndQuoteClient</implementation>
            <scope>singleton</scope>
        </component>

        <component>
            <type>com.tbscg.doosan.magnolia.product.catalog.extimport.buildandquote.BuildAndQuoteService</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.extimport.buildandquote.DefaultBuildAndQuoteService</implementation>
            <scope>singleton</scope>
        </component>

        <component>
            <type>com.tbscg.doosan.magnolia.filtering.ValidNodeTypesProvider</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.filtering.ProductValidTypesProvider</implementation>
            <scope>singleton</scope>
        </component>

        <type-mapping>
            <type>info.magnolia.ui.chooser.WorkbenchChooser</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.customs.CustomWorkbenchChooser</implementation>
        </type-mapping>
    </components>

    <components>
        <id>admincentral</id>
        <type-mapping>
            <type>info.magnolia.ui.contentapp.browser.ActionExecutionService</type>
            <implementation>com.tbscg.doosan.magnolia.product.catalog.customs.CustomCompatibilityActionExecutionService</implementation>
        </type-mapping>
    </components>

    <dependencies>
        <dependency>
            <name>core</name>
            <version>*</version>
        </dependency>
        <dependency>
            <name>cloudinary</name>
            <version>*</version>
        </dependency>
        <dependency>
            <name>translation</name>
            <version>*</version>
        </dependency>
    </dependencies>

</module>
