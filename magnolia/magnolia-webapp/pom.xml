									<magnolia.resources.dir>${project.basedir}/../magnolia-light-modules/src/main/webapp/modules</magnolia.resources.dir>
									<magnolia.home>${project.basedir}/data-postgres</magnolia.home>
									<magnolia.docker.version.file>${project.basedir}/local_version</magnolia.docker.version.file>
									<magnolia.feature.environment.id>local</magnolia.feature.environment.id>
									<com.amazonaws.xray.emitters.daemonAddress>127.0.0.1:2000</com.amazonaws.xray.emitters.daemonAddress>
									<com.amazonaws.xray.strategy.contextMissingStrategy>LOG_ERROR</com.amazonaws.xray.strategy.contextMissingStrategy>
									<com.amazonaws.xray.strategy.tracingName>magnolia.local</com.amazonaws.xray.strategy.tracingName>
									<jcr.cloudinary.api.secret>${env.CLOUDINARY_API_SECRET}</jcr.cloudinary.api.secret>
									<jcr.auth.magnolia.kags.okta.secret>dummysecret</jcr.auth.magnolia.kags.okta.secret>
									<jcr.auth.magnolia.kags.smartequip.secret>dummysecret</jcr.auth.magnolia.kags.smartequip.secret>
									<jcr.auth.magnolia.pmd.okta.secret>dummysecret</jcr.auth.magnolia.pmd.okta.secret>
									<jcr.auth.magnolia.enigma.okta.secret>dummysecret</jcr.auth.magnolia.enigma.okta.secret>
									<jcr.auth.magnolia.license>${env.MAGNOLIA_LICENSE_KEY}</jcr.auth.magnolia.license>
									<jcr.auth.magnolia.kags.key.account.okta.secret>dummysecret</jcr.auth.magnolia.kags.key.account.okta.secret>
									<jcr.auth.magnolia.pimpp.okta.secret>dummysecret</jcr.auth.magnolia.pimpp.okta.secret>
									<jcr.auth.magnolia.gpim.secret>dummysecret</jcr.auth.magnolia.gpim.secret>
									<jcr.google.translation.api.key>${env.GOOGLE_TRANSLATION_API_KEY}</jcr.google.translation.api.key>
								</systemProperties>
								<systemPropertiesFile>${project.build.directory}/tomcatconf/db.properties</systemPropertiesFile>
								<zipUrlInstaller>
									<url>https://archive.apache.org/dist/tomcat/tomcat-9/v${tomcat.version}/bin/apache-tomcat-${tomcat.version}.zip</url>
									<downloadDir>${project.basedir}/target/cargo/downloads</downloadDir>
									<extractDir>${project.basedir}/tomcat</extractDir>
								</zipUrlInstaller>
							</container>
							<deployables>
								<deployable>
									<groupId>com.doosan.dxp.cms</groupId>
									<artifactId>magnolia-webapp</artifactId>
									<type>war</type>
									<properties>
										<context>/</context>
									</properties>
								</deployable>
							</deployables>
							<configuration>
								<properties>
									<cargo.servlet.port>8080</cargo.servlet.port>
									<cargo.logging>high</cargo.logging>
									<context>/</context>
									<cargo.jvmargs>
                                        -Xmx4096m
                                        -Xms256m
										--add-opens java.base/java.lang=ALL-UNNAMED
										-agentlib:jdwp=transport=dt_socket,address=127.0.0.1:8000,server=y,suspend=n
                                    </cargo.jvmargs>
								</properties>
							</configuration>
						</configuration>
						<executions>
							<execution>
								<id>run-tomcat</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/main/tomcatconf</directory>
				<filtering>true</filtering>
				<targetPath>${project.build.directory}/tomcatconf</targetPath>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.4.0</version>
				<configuration>
					<dependentWarExcludes>WEB-INF/lib/*.jar</dependentWarExcludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
