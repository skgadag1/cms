<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         metadata-complete="true">
  <description>Magnolia</description>
  <display-name>magnolia</display-name>
  <distributable />

  <filter>
    <display-name>Magnolia global filters</display-name>
    <filter-name>magnoliaFilterChain</filter-name>
    <filter-class>info.magnolia.cms.filters.MgnlMainFilter</filter-class>
    <async-supported>true</async-supported>
  </filter>
  <filter>
    <filter-name>AWSXRayServletFilter</filter-name>
    <filter-class>com.tbscg.doosan.magnolia.monitoring.setup.CustomAWSXRayServletFilter</filter-class>
    <async-supported>true</async-supported>
    <init-param>
      <param-name>fixedName</param-name>
      <param-value>magnolia</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>AWSXRayServletFilter</filter-name>
    <url-pattern>*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>magnoliaFilterChain</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
    <dispatcher>FORWARD</dispatcher>
    <dispatcher>INCLUDE</dispatcher>
    <dispatcher>ERROR</dispatcher>
  </filter-mapping>
  <!--
  <servlet>
    <servlet-name>Vaadin</servlet-name>
    <servlet-class>com.vaadin.server.VaadinServlet</servlet-class>
    <init-param>
      <description>Groovy Rescue App</description>
      <param-name>UI</param-name>
      <param-value>info.magnolia.module.groovy.rescue.MgnlGroovyRescueApp</param-value>
    </init-param>
    <init-param>
      <param-name>widgetset</param-name>
      <param-value>info.magnolia.widgetset.MagnoliaProWidgetSet</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>Vaadin</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>
-->

  <listener>
    <listener-class>info.magnolia.init.MagnoliaServletContextListener</listener-class>
  </listener>
  <listener>
    <listener-class>com.tbscg.doosan.magnolia.dxp.core.servlet.CustomMagnoliaServletContextListener</listener-class>
  </listener>
  <listener>
    <listener-class>com.tbscg.doosan.magnolia.monitoring.Startup</listener-class>
  </listener>

  <context-param>
    <description>Vaadin production mode</description>
    <param-name>productionMode</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>heartbeatInterval</param-name>
    <param-value>90</param-value>
  </context-param>
  <context-param>
    <param-name>magnolia.initialization.file</param-name>
    <param-value>
      WEB-INF/config/env_${environment}/instance_${instanceType}.properties,
      WEB-INF/config/env_${environment}/common.properties,
      WEB-INF/config/db/${dbType}.properties,
      WEB-INF/config/default/instance_${instanceType}.properties,
      WEB-INF/config/default/magnolia.properties
    </param-value>
  </context-param>
  <context-param>
    <param-name>org.atmosphere.cpr.AtmosphereConfig.getInitParameter</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>org.atmosphere.websocket.suppressJSR356</param-name>
    <param-value>true</param-value>
  </context-param>
  <error-page>
    <error-code>404</error-code>
    <location>/docroot/404.html</location>
  </error-page>
</web-app>
