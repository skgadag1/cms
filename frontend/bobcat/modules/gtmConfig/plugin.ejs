export default (context, inject) => {
  if (context.__hasGtmConfig__ !== true) {
    try {
      const options = <%= JSON.stringify(options || {}, undefined, 2) %>

      const gtmCfg = {id: options?.id}
      options?.['@nodes']?.map((region) => { gtmCfg[region] = options[region] })
      context.$gtmConfig = gtmCfg
      inject('gtmConfig', gtmCfg)
      context.__hasGtmConfig__ = true
    } catch (e) {
      // eslint-disable-next-line no-console
      console.warn('[GtmConfig Plugin] Unable to inject GTM config', e)
    }
  }
}
