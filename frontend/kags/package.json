{
  "name": "KAGS-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "serve-api": "vite --mode devapi",
    "extract-concepts": "node scripts/concepts-extractor.js",
    "build": "vite build",
    "lint": "eslint --ext .js,.ts,.vue src",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "jest --silent",
    "test:unit:dev": "jest",
    "inspect": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "build-project": "yarn type-check && jest --silent && vite build && node scripts/concepts-extractor.js",
    "build-project:skip-tests": "yarn type-check && vite build && node scripts/concepts-extractor.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.25",
    "@fortawesome/free-solid-svg-icons": "^5.11.2",
    "@fortawesome/pro-light-svg-icons": "^5.12.0",
    "@fortawesome/pro-regular-svg-icons": "^5.11.2",
    "@fortawesome/pro-solid-svg-icons": "^5.11.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@vue/compat": "^3.5.42",
    "@vuepic/vue-datepicker": "^9.0.0",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.20.0",
    "axios-extensions": "^4.0.0",
    "bootstrap": "^5.3.0",
    "bootstrap-vue-next": "0.43.7",
    "langs": "^2.0.0",
    "moment": "^2.30.1",
    "qs": "^6.12.3",
    "vue": "^3.5.42",
    "vue3-google-map": "^0.27.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7",
    "@swc/core": "^1.7.26",
    "@swc/jest": "^0.2.37",
    "@types/glob": "^7",
    "@types/lodash.template": "^4.5.3",
    "@types/node": "^24",
    "@types/svg2ttf": "^5.0.3",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.5.0",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "flush-promises": "^1.0.2",
    "glob": "^7.2.3",
    "jest": "^29.7.0",
