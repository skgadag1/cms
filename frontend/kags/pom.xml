<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.doosan.dxp.cms</groupId>
    <artifactId>frontend-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>frontend-kags</artifactId>
  <packaging>fea</packaging>

  <properties>
    <kags.build.script>build-project</kags.build.script>
  </properties>

  <profiles>
    <!-- Jest runs inside the yarn script, so -Dmaven.test.skip=true has to pick a script without it. -->
    <profile>
      <id>skip-tests</id>
      <activation>
        <property>
          <name>maven.test.skip</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <kags.build.script>build-project:skip-tests</kags.build.script>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>yarn build</id>
            <goals>
              <goal>yarn</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>${kags.build.script}</arguments>
            </configuration>
          </execution>
          <execution>
            <id>yarn build preview</id>
            <goals>
              <goal>yarn</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>build --mode preview</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.doosan.plugins.maven.cms</groupId>
        <artifactId>cms-package-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>package-frontend-artifacts</id>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
